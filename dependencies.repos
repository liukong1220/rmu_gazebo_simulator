# Deprecated nested manifest.
#
# The ATS 2026 sentry workspace owns every Gazebo-domain source dependency in
# the root manifest instead:
#
#   <workspace>/dependencies.repos
#     src/dependencies/rmoss_core
#     src/dependencies/rmoss_gazebo
#     src/dependencies/rmoss_gz_resources
#     src/dependencies/rmoss_interfaces
#     src/dependencies/sdformat_tools
#
# Keeping a second active dependency root here would allow two different
# versions of rmoss_interfaces/sdformat_tools to resolve at build time, so this
# file intentionally imports nothing.
#
# The simulator no longer carries a private legacy robot description. The
# launch files resolve ats_robot_description (imported by the root manifest) via
# the robot_description_package launch argument.
repositories: {}
