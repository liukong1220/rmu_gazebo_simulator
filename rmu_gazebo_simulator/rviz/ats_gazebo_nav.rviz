Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /ATS Paths1
      Splitter Ratio: 0.8
    Tree Height: 880
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.25
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Alpha: 0.55
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Static Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Value: /map_updates
      Use Timestamp: false
      Value: true
    - Alpha: 0.18
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Planning Grid
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rc_esdf/planning_grid
      Update Topic:
        Value: /rc_esdf/planning_grid_updates
      Use Timestamp: false
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 200; 200; 200
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Registered Scan
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /registered_scan
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 80; 80
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: ROGMap Inflated Occupancy
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.05
      Style: Boxes
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /rog_map/inf_occ
      Use Fixed Frame: true
      Value: false
    - Class: rviz_common/Group
      Displays:
        # 1. JPS global search path: discrete search result, light blue.
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 80; 170; 255
          Enabled: true
          Head Diameter: 0
          Head Length: 0
          Length: 0.3
          Line Style: Lines
          Line Width: 0.07
          Name: 1 JPS Global Path
          Offset:
            X: 0
            Y: 0
            Z: 0.03
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0
          Shaft Length: 0
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /minco/raw_path
          Value: true
        # 2. MINCO optimized reference: continuous optimized path, orange.
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 150; 30
          Enabled: true
          Head Diameter: 0
          Head Length: 0
          Length: 0.3
          Line Style: Lines
          Line Width: 0.08
          Name: 2 MINCO Reference Path
          Offset:
            X: 0
            Y: 0
            Z: 0.05
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0
          Shaft Length: 0
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /minco/reference_path
          Value: true
        # 3. MPC prediction for the current control cycle, magenta billboards.
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 220; 60; 255
          Enabled: true
          Head Diameter: 0
          Head Length: 0
          Length: 0.3
          Line Style: Billboards
          Line Width: 0.08
          Name: 3 MPC Predicted Path
          Offset:
            X: 0
            Y: 0
            Z: 0.07
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0
          Shaft Length: 0
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /ats_swerve_mpc/predicted_path
          Value: true
        # 4. Realised trajectory sampled from /localization by
        #    executed_path_observer. Not a copy of 2 or 3; green billboards.
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 60; 230; 130
          Enabled: true
          Head Diameter: 0
          Head Length: 0
          Length: 0.3
          Line Style: Billboards
          Line Width: 0.09
          Name: 4 MPC Executed Path
          Offset:
            X: 0
            Y: 0
            Z: 0.09
          Pose Style: None
          Radius: 0.03
          Shaft Diameter: 0
          Shaft Length: 0
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /ats_swerve_mpc/executed_path
          Value: true
      Enabled: true
      Name: ATS Paths
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: MINCO Debug Markers
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /minco/debug_markers
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
Views:
  Current:
    Angle: 0
    Class: rviz_default_plugins/TopDownOrtho
    Enable Stereo Rendering:
      Stereo Eye Separation: 0.05999999865889549
      Stereo Focal Distance: 1
      Swap Stereo Eyes: false
      Value: false
    Invert Z Axis: false
    Name: Current View
    Near Clip Distance: 0.009999999776482582
    Scale: 30
    Target Frame: <Fixed Frame>
    Value: TopDownOrtho (rviz_default_plugins)
    X: 0
    Y: 0
  Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1720
  X: 60
  Y: 60
